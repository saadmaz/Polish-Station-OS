{
  "name": "polish-station-pos",
  "version": "1.1.3",
  "description": "Point-of-sale and shop-management platform for Polish Station: bookings, inspections, jobs, checkout, inventory and staff.",
  "homepage": "https://github.com/saadmaz/Polish-Station-POS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadmaz/Polish-Station-POS.git"
  },
  "bugs": {
    "url": "https://github.com/saadmaz/Polish-Station-POS/issues"
  },
  "author": "Saad Mazhar (https://github.com/saadmaz)",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/write-build-id.mjs && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:staff": "tsx scripts/seed-staff.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "migrate:staff-auth": "tsx scripts/migrate-staff-auth.ts",
    "reset:staff": "tsx scripts/reset-staff.ts",
    "purge:staff": "tsx scripts/purge-staff.ts",
    "deploy:rules": "tsx scripts/deploy-rules.ts",
    "seed:data": "tsx scripts/seed-data.ts",
    "migrate:vehicles": "tsx scripts/migrate-vehicles.ts",
    "migrate:invoice-bookings": "tsx scripts/migrate-invoice-bookings.ts",
    "migrate:booking-jobs": "tsx scripts/migrate-booking-jobs.ts",
    "migrate:lead-preferred-window": "tsx scripts/migrate-lead-preferred-window.ts",
    "test:rules": "firebase emulators:exec --only firestore \"node scripts/test-rules.mjs\"",
    "test:e2e": "firebase emulators:exec --project demo-pos-polishstation --only firestore,auth \"bash scripts/e2e/run.sh\"",
    "seed:ui-test": "node scripts/seed-emulator.mjs --ui-test",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^9.47.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "playwright": "^1.61.1",
    "prettier": "^3.7.3",
    "sharp": "^0.35.4",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^3.2.4"
  }
}
